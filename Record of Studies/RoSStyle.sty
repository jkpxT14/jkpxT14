% Document identity follows the Acknowledgements header.
\newcommand{\RoSOwnerName}{}
\newcommand{\RoSOwnerAffiliation}{}
\newcommand{\RoSOwnerContact}{}
\newcommand{\setrosownername}[1]{\renewcommand{\RoSOwnerName}{#1}}
\newcommand{\setrosowneraffiliation}[1]{\renewcommand{\RoSOwnerAffiliation}{#1}}
\newcommand{\setrosownercontact}[1]{\renewcommand{\RoSOwnerContact}{#1}}
\newcommand{\rosemail}[1]{\href{mailto:#1}{#1}}
\newcommand{\rosurl}[1]{\href{#1}{\nolinkurl{#1}}}
\newcommand{\roscontactsep}{,\enspace}

\newcommand{\makerosheader}{%
  \begin{center}
    {\fontsize{22.1}{25.0}\selectfont\normalfont \RoSOwnerName\par}
    \vspace{0.31em}
    {\fontsize{10.2}{12.1}\selectfont \RoSOwnerAffiliation\par}
    \ifdefempty{\RoSOwnerContact}{}{%
      \vspace{0.09em}
      {\fontsize{8.9}{10.6}\selectfont \RoSOwnerContact\par}%
    }
  \end{center}
  \vspace{0.78em}
  \begin{center}
    {\fontsize{16.0}{18.5}\selectfont\normalfont Record of Studies\par}
    \vspace{0.34em}
    {\fontsize{9.8}{12.0}\selectfont\color{RoSGray}
      The books, papers, and courses that have shaped my academic journey.\par}
  \end{center}
  \vspace{0.78em}
}

% Identical visible section style to CV/Acknowledgements.
\newcommand{\rossection}[1]{%
  \Needspace{3.5\baselineskip}%
  \par\vspace{1.14em}
  {\fontsize{12.7}{14.7}\selectfont\normalfont #1\par}
  \vspace{0.035em}
  {\color{black}\rule{\linewidth}{0.28pt}}\par
  \vspace{0.30em}
}

% Shared title-first record; a status is optional, and never replaces the title.
\newcommand{\rosrecord}[3]{%
  \par\addvspace{0.61em}%
  \Needspace{3.5\baselineskip}%
  {\fontsize{10.2}{12.0}\selectfont\bfseries #1%
    \ifstrempty{#3}{}{\nobreak\hspace{0.42em}{\fontsize{8.9}{10.4}\selectfont\normalfont\color{RoSGray}(#3)}}\par}%
  \vspace{0.035em}
  {\fontsize{9.7}{11.7}\selectfont #2\par}%
}

\newcommand{\rosbook}[3][]{\rosrecord{#2}{#3}{#1}}
\newcommand{\rospaper}[3][]{\rosrecord{#2}{#3}{#1}}

% For occasional edition/venue/reading notes; omitted from ordinary entries.
\newcommand{\rosdetails}[1]{%
  \ifstrempty{#1}{}{%
    \vspace{0.07em}
    {\fontsize{9.2}{10.9}\selectfont\color{RoSGray}#1\par}%
  }%
}

% Course: title | semester; instructor; institution [course code].
% Empty course code or semester produces no dangling punctuation or blank cells.
\newcommand{\rosmetasep}{\enspace\textperiodcentered\enspace}
\newcommand{\roscourse}[5]{%
  \par\addvspace{0.61em}%
  \Needspace{4.1\baselineskip}%
  \begin{tabularx}{\linewidth}{@{}>{\RaggedRight\arraybackslash}X r@{}}
    {\fontsize{10.2}{12.0}\selectfont\bfseries #1} &
    {\fontsize{9.5}{11.3}\selectfont #5}\\[-0.01em]
    \multicolumn{2}{@{}>{\RaggedRight\arraybackslash}p{\linewidth}@{}}{%
      {\fontsize{9.7}{11.7}\selectfont #2}}\\[-0.01em]
    \multicolumn{2}{@{}>{\RaggedRight\arraybackslash}p{\linewidth}@{}}{%
      {\fontsize{9.7}{11.7}\selectfont #3\ifstrempty{#4}{}{\rosmetasep #4}}}
  \end{tabularx}\par
}
