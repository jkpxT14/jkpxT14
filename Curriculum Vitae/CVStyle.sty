\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{CVStyle}[2026/09/02 Mathematics academic CV style v11]

% =============================================================
% Page and typography
% =============================================================
\RequirePackage[a4paper,top=1.88cm,bottom=1.82cm,left=2.12cm,right=2.12cm]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{libertine}
\RequirePackage[protrusion=true,expansion=true]{microtype}
\RequirePackage{xcolor}
\RequirePackage{hyperref}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{ragged2e}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{etoolbox}
\RequirePackage{needspace}

\InputIfFileExists{InstitutionColors.tex}{}{}

\definecolor{CVGray}{HTML}{666666}
\definecolor{CVLightGray}{HTML}{8A8A8A}

% Color is semantic, not decorative. Reserve it for institution-related text.
\newcommand{\institutiontext}[2]{\textcolor{#1}{#2}}

% Shared institution wrappers keep school identity colors consistent across the
% personal document family.
\newcommand{\postechtext}[1]{\institutiontext{POSTECHRed}{#1}}
\newcommand{\koreatext}[1]{\institutiontext{KoreaUniversityCrimson}{#1}}
\newcommand{\snutext}[1]{\institutiontext{SNUBlue}{#1}}
\newcommand{\yonseitext}[1]{\institutiontext{YonseiBlue}{#1}}
\newcommand{\cambridgetext}[1]{\institutiontext{CambridgeDarkBlue}{#1}}
\newcommand{\mittext}[1]{\institutiontext{MITRed}{#1}}
\newcommand{\kaisttext}[1]{\institutiontext{KAISTBlue}{#1}}

\hypersetup{
  colorlinks=true,
  urlcolor=black,
  linkcolor=black,
  citecolor=black,
  pdfauthor={Jungwoo Kim},
  pdftitle={Curriculum Vitae}
}
\urlstyle{same}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\linespread{1.01}
\AtBeginDocument{\RaggedRight}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[C]{\fontsize{8.0}{9.3}\selectfont\color{CVGray}\thepage\,/\,\pageref*{LastPage}}
\setlength{\footskip}{0.78cm}

% =============================================================
% Header information
% =============================================================
\newcommand{\CVName}{}
\newcommand{\CVAffiliation}{}
\newcommand{\CVLocation}{}
\newcommand{\CVEmail}{}
\newcommand{\CVWebsiteURL}{}
\newcommand{\CVWebsiteText}{}
\newcommand{\CVGitHubURL}{}
\newcommand{\CVGitHubText}{}

\newcommand{\setcvname}[1]{\renewcommand{\CVName}{#1}}
\newcommand{\setcvaffiliation}[1]{\renewcommand{\CVAffiliation}{#1}}
\newcommand{\setcvlocation}[1]{\renewcommand{\CVLocation}{#1}}
\newcommand{\setcvemail}[1]{\renewcommand{\CVEmail}{#1}}
\newcommand{\setcvwebsite}[2]{%
  \renewcommand{\CVWebsiteURL}{#1}%
  \renewcommand{\CVWebsiteText}{#2}%
}
\newcommand{\setcvgithub}[2]{%
  \renewcommand{\CVGitHubURL}{#1}%
  \renewcommand{\CVGitHubText}{#2}%
}

\newcommand{\makecvheader}{%
  \begin{center}
    {\fontsize{22.1}{25.0}\selectfont\normalfont \CVName\par}
    \vspace{0.31em}
    {\fontsize{10.2}{12.1}\selectfont \CVAffiliation\par}
    \vspace{0.11em}
    {\fontsize{9.8}{11.6}\selectfont \CVLocation\par}
    \vspace{0.11em}
    {\fontsize{9.4}{11.2}\selectfont
      \href{mailto:\CVEmail}{\CVEmail}%
      \ifdefempty{\CVWebsiteURL}{}{,\enspace\href{\CVWebsiteURL}{\CVWebsiteText}}%
      \ifdefempty{\CVGitHubURL}{}{,\enspace\href{\CVGitHubURL}{\CVGitHubText}}\par}
  \end{center}
  \vspace{0.68em}
}

% =============================================================
% Section hierarchy
% =============================================================
\newcommand{\cvsection}[1]{%
  \Needspace{6.0\baselineskip}%
  \par\vspace{1.14em}
  {\fontsize{12.7}{14.7}\selectfont\normalfont #1\par}
  \vspace{0.035em}
  {\color{black}\rule{\linewidth}{0.28pt}}\par
  \vspace{0.30em}
}

% Use visible subsections sparingly; most short undergraduate CV sections are
% cleaner as one list. This remains available when a section grows.
\newcommand{\cvsubsection}[1]{%
  \par\vspace{0.28em}
  {\fontsize{10.4}{12.2}\selectfont\bfseries #1\par}
  \vspace{0.08em}
}

% Placeholder command is retained for source-side templates only; empty CV
% sections should not render placeholder content in the PDF.
\newcommand{\placeholder}[1]{{\itshape\color{CVLightGray}[#1]}}
\newcommand{\cvtext}[1]{#1\par}

% =============================================================
% Reusable entry structures
% =============================================================
\newcommand{\cvprimary}[1]{{\bfseries #1}}

% Generic academic entry: primary item / dates; secondary line; details.
\newcommand{\cventry}[4]{%
  \begin{tabularx}{\linewidth}{@{}>{\RaggedRight\arraybackslash}X r@{}}
    \cvprimary{#1} & #2 \\
    \multicolumn{2}{@{}l@{}}{#3} \\
    \multicolumn{2}{@{}>{\RaggedRight\arraybackslash}p{\linewidth}@{}}{#4}
  \end{tabularx}\par
}

% Primary degree institution. Institution first, then degree/program details.
% This keeps the degree-granting university visually dominant in Education.
\newcommand{\cveducation}[6]{%
  \begin{tabularx}{\linewidth}{@{}>{\RaggedRight\arraybackslash}X r@{}}
    \cvprimary{#1} & #2 \\
    #3 & #4%
    \ifstrempty{#5}{}{\\[-0.04em]\multicolumn{2}{@{}l@{}}{#5}}%
    \ifstrempty{#6}{}{\\[-0.01em]\multicolumn{2}{@{}>{\RaggedRight\arraybackslash}p{\linewidth}@{}}{#6}}%
  \end{tabularx}\par
}

% Exchange / visiting study is deliberately secondary to the degree institution.
% The whole block is indented slightly; do not shrink it or gray it out.
\newcommand{\cvsecondaryeducation}[6]{%
  \noindent\hspace*{0.42cm}%
  \begin{minipage}{\dimexpr\linewidth-0.42cm\relax}
    \begin{tabularx}{\linewidth}{@{}>{\RaggedRight\arraybackslash}X r@{}}
      \cvprimary{#1} & #2 \\
      #3 & #4%
      \ifstrempty{#5}{}{\\[-0.04em]\multicolumn{2}{@{}l@{}}{#5}}%
      \ifstrempty{#6}{}{\\[-0.01em]\multicolumn{2}{@{}>{\RaggedRight\arraybackslash}p{\linewidth}@{}}{#6}}%
    \end{tabularx}
  \end{minipage}\par
}

% Research experience: role / dates; institution / location; advisor/topic;
% optional concise mathematical description.
\newcommand{\cvresearchexperience}[6]{%
  \begin{tabularx}{\linewidth}{@{}>{\RaggedRight\arraybackslash}X r@{}}
    \cvprimary{#1} & #2 \\
    #3 & #4%
    \ifstrempty{#5}{}{\\[-0.03em]\multicolumn{2}{@{}>{\RaggedRight\arraybackslash}p{\linewidth}@{}}{#5}}%
  \end{tabularx}\par
  \ifstrempty{#6}{}{\vspace{-0.05em}#6\par}%
}

% Honors, awards, scholarships, olympiads, and mathematics competitions.
\newcommand{\cvaward}[3]{%
  \begin{tabularx}{\linewidth}{@{}>{\RaggedRight\arraybackslash}X r@{}}
    \cvprimary{#1} & #2 \\
    \multicolumn{2}{@{}>{\RaggedRight\arraybackslash}p{\linewidth}@{}}{#3}
  \end{tabularx}\par
}

% Academic activities: representative roles, selective programs, summer
% schools, REUs, workshops, and substantive competition participation.
\newcommand{\cvactivity}[3]{%
  \begin{tabularx}{\linewidth}{@{}>{\RaggedRight\arraybackslash}X r@{}}
    \cvprimary{#1} & #2 \\
    \multicolumn{2}{@{}>{\RaggedRight\arraybackslash}p{\linewidth}@{}}{#3}
  \end{tabularx}\par
}

% Variant with one extra line for a competition result or current status.
\newcommand{\cvactivitywithresult}[4]{%
  \begin{tabularx}{\linewidth}{@{}>{\RaggedRight\arraybackslash}X r@{}}
    \cvprimary{#1} & #2 \\
    \multicolumn{2}{@{}>{\RaggedRight\arraybackslash}p{\linewidth}@{}}{#3}\\[-0.03em]
    \multicolumn{2}{@{}>{\RaggedRight\arraybackslash}p{\linewidth}@{}}{#4}
  \end{tabularx}\par
}

% Non-academic or cross-domain activity/project. Keep these compact so they do
% not visually compete with research and publications earlier in the CV.
\newcommand{\cvselecteditem}[4]{%
  \begin{tabularx}{\linewidth}{@{}>{\RaggedRight\arraybackslash}X r@{}}
    \cvprimary{#1} & #2 \\
    \multicolumn{2}{@{}>{\RaggedRight\arraybackslash}p{\linewidth}@{}}{#3}%
    \ifstrempty{#4}{}{\\[-0.03em]\multicolumn{2}{@{}>{\RaggedRight\arraybackslash}p{\linewidth}@{}}{#4}}%
  \end{tabularx}\par
}

\newcommand{\cvtalk}[4]{%
  \begin{tabularx}{\linewidth}{@{}>{\RaggedRight\arraybackslash}X r@{}}
    \cvprimary{#1} & #2 \\
    #3 & #4
  \end{tabularx}\par
}

\newcommand{\cvteaching}[4]{%
  \begin{tabularx}{\linewidth}{@{}>{\RaggedRight\arraybackslash}X r@{}}
    \cvprimary{#1} & #2 \\
    \multicolumn{2}{@{}>{\RaggedRight\arraybackslash}p{\linewidth}@{}}{#3}%
    \ifstrempty{#4}{}{\\[-0.03em]\multicolumn{2}{@{}>{\RaggedRight\arraybackslash}p{\linewidth}@{}}{#4}}%
  \end{tabularx}\par
}

% Repeated mentoring or teaching within one program: show the program once,
% then accumulate semester-level records underneath it with a small indent.
\newcommand{\cvteachingprogram}[1]{%
  \cvprimary{#1}\par
  \vspace{0.06em}%
}

\newcommand{\cvteachingrecord}[2]{%
  \noindent\hspace*{0.42cm}%
  \begin{minipage}{\dimexpr\linewidth-0.42cm\relax}
    \begin{tabularx}{\linewidth}{@{}>{\RaggedRight\arraybackslash}X r@{}}
      #1 & #2
    \end{tabularx}
  \end{minipage}\par
}

% Papers/preprints: numbered like a conventional academic publication list.
\newcommand{\cvpublication}[4]{%
  \begin{tabularx}{\linewidth}{@{}p{1.8em}>{\RaggedRight\arraybackslash}X@{}}
    [#1] & \cvprimary{#2} \\
         & #3 \\
         & #4
  \end{tabularx}\par
}

% Books, handbooks, lecture notes, and expository writing are intentionally
% separate from research publications. State the type/status honestly.
\newcommand{\cvwrittenwork}[4]{%
  \begin{tabularx}{\linewidth}{@{}>{\RaggedRight\arraybackslash}X r@{}}
    {\itshape #1} & #2 \\
    \multicolumn{2}{@{}>{\RaggedRight\arraybackslash}p{\linewidth}@{}}{#3}%
    \ifstrempty{#4}{}{\\[-0.03em]\multicolumn{2}{@{}>{\RaggedRight\arraybackslash}p{\linewidth}@{}}{#4}}%
  \end{tabularx}\par
}

\newcommand{\cvskillline}[2]{%
  \textbf{#1:} #2\par
}

\newenvironment{cvitems}{%
  \begin{itemize}[
    leftmargin=1.15em,
    label=\raisebox{0.13ex}{\scriptsize$\bullet$},
    itemsep=0.05em,
    topsep=0.12em,
    parsep=0pt,
    partopsep=0pt
  ]
}{%
  \end{itemize}
}

\newcommand{\cvspace}{\vspace{0.22em}}
